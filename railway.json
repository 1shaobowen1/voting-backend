{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "languages": {
        "node": {
          "version": "18"
        }
      }
    }
  },
  "deploy": {
    "numInstances": 1,
    "restartPolicyType": "onFailure",
    "restartPolicyLimit": 5,
    "healthcheckPath": "/health",
    "sleepApplication": true
  }
}
